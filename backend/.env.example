# Copy to .env, use unique strong tokens, and NEVER commit it.
NODE_ENV=development
HOST=127.0.0.1
PORT=8443
MONGODB_URI=mongodb://127.0.0.1:27018/aquasentra
TLS_CERT_PATH=certs/dev-cert.pem
TLS_KEY_PATH=certs/dev-key.pem
BOOTSTRAP_DEVICE_ID=AS-ESP32-001
BOOTSTRAP_DEVICE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_DEVICE_TOKEN
BOOTSTRAP_ADMIN_ID=research-admin
BOOTSTRAP_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADMIN_TOKEN
BOOTSTRAP_VIEWER_ID=research-viewer
BOOTSTRAP_VIEWER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_VIEWER_TOKEN
